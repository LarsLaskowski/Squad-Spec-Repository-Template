root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The C# rules come from the template: .squad/tools/dotnet-rules.py writes its baseline into the dotnet-rules blocks,
# .squad/tools/sonar-rules.py the project's SonarQube Cloud profile into the sonar-rules block. The project's own
# sections of paths (generated code, migrations) go after the paths block.
[*.cs]
# squad:dotnet-rules begin — written by .squad/tools/dotnet-rules.py from .squad/dotnet-rules.editorconfig, the template's rule baseline; never edited by hand (.squad/stack.md, Analyzer gate)
# squad:dotnet-rules end

# squad:sonar-rules begin — written by .squad/tools/sonar-rules.py from the project's SonarQube Cloud C# profile against "Sonar way core"; never edited by hand (.squad/stack.md, Analyzer gate)
# squad:sonar-rules end

# squad:dotnet-rules-paths begin — written by .squad/tools/dotnet-rules.py from .squad/dotnet-rules.editorconfig, the template's rule baseline; never edited by hand (.squad/stack.md, Analyzer gate)
# squad:dotnet-rules-paths end
