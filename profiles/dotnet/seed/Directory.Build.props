<Project>
  <!-- One build structure in every .NET repository of the template (.squad/stack.md, Toolchain): the target framework
       and these switches are set here once, never in a project file; dotnet_config.py checks it in the Analyzer gate.
       The values of the target framework and the packages are the project's. -->
  <PropertyGroup>
    <TargetFramework>{{TODO: target framework, e.g. net10.0}}</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!-- The analyzers in every project, dev-only, so SonarQube Cloud's issues surface in the local build -->
  <ItemGroup>
    <PackageReference Include="Reihitsu.Analyzer" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <!-- The rules the baseline switches off, also for generated code (Razor components) that .editorconfig misses -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).squad/dotnet-rules.globalconfig" />
  </ItemGroup>
  <!-- Every test project (name ending in .Tests): MSTest, which brings MSTest.Analyzers, and coverage -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
</Project>
